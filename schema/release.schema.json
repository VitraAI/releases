{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitraai.github.io/releases/schema/release.schema.json",
  "title": "Universe release",
  "description": "One release's notes: the source file in releases/<id>.json. The build turns it into a JSON Feed 1.1 item (feed.json) whose `_universe` extension carries the sections below. This repo is public: everything in a release file is customer-facing. Leave hidden or internal changes out entirely.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "date", "title", "summary", "sections"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "description": "Version of this file format.",
      "const": 1
    },
    "id": {
      "description": "Calendar version: YYYY.MM.DD, plus .N for a second release on the same day.",
      "type": "string",
      "pattern": "^\\d{4}\\.(0[1-9]|1[0-2])\\.(0[1-9]|[12]\\d|3[01])(\\.[2-9])?$"
    },
    "date": {
      "description": "Release day (IST), YYYY-MM-DD. Must match the id.",
      "type": "string",
      "format": "date"
    },
    "title": {
      "description": "The release's headline: its biggest customer-facing change.",
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "summary": {
      "description": "One sentence listing the main changes. Used as the feed summary and the Slack notification text.",
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "image": {
      "$ref": "#/$defs/mediaUrl"
    },
    "backfill": {
      "description": "Written after the fact from an older release note. Never posted to Slack.",
      "type": "boolean"
    },
    "highlights": {
      "description": "Section ids to feature first, in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true,
      "maxItems": 3
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": {
      "description": "Keep a Changelog 1.1 category.",
      "enum": ["added", "changed", "deprecated", "removed", "fixed", "security"]
    },
    "text": {
      "description": "Inline Markdown subset: **bold**, _italic_, `code`, [label](https://url). No HTML, no line breaks.",
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[<>\\n]"
      }
    },
    "mediaUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "area", "kind", "title", "items"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "area": {
          "description": "An id from config/areas.json. Sets the icon and the Slack emoji.",
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "emoji": {
          "description": "Slack shortcode overriding the area's emoji, without colons.",
          "type": "string",
          "pattern": "^[a-z0-9_+-]+$"
        },
        "note": {
          "description": "A short aside shown under the title, e.g. who it is for.",
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["title"]
        },
        {
          "required": ["body"]
        }
      ],
      "properties": {
        "title": {
          "description": "Bold one-sentence lead-in.",
          "$ref": "#/$defs/text"
        },
        "body": {
          "description": "One to three short sentences after the lead-in.",
          "$ref": "#/$defs/text"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "children": {
          "description": "Sub-points, rendered as an indented list. One level only.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/child"
          }
        },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "url", "alt"],
            "properties": {
              "type": {
                "enum": ["image", "video"]
              },
              "url": {
                "$ref": "#/$defs/mediaUrl"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "link": {
          "description": "path: in-app, relative to the org (/projects). url: an absolute https link.",
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "oneOf": [
            {
              "required": ["path"]
            },
            {
              "required": ["url"]
            }
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "path": {
              "type": "string",
              "pattern": "^/[a-z0-9/_-]*$"
            },
            "url": {
              "$ref": "#/$defs/mediaUrl"
            }
          }
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["title"]
        },
        {
          "required": ["body"]
        }
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "body": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
